# Local JSON index. Production can replace the repository with Supabase pgvector.
ZAPPY_RAG_INDEX_PATH=data/index/chunks.json

# Local Part 2 demo settings. Replace the token outside local development.
ZAPPY_DEMO_SESSION_TOKEN=demo-session
ZAPPY_MCP_HOST=127.0.0.1
ZAPPY_MCP_PORT=8001
ZAPPY_SMARTHOME_MCP_HOST=127.0.0.1
ZAPPY_SMARTHOME_MCP_PORT=8006

# Server-side URL used by the Next.js same-origin proxy.
ZAPPY_API_URL=http://127.0.0.1:8000
# Must match site_id in the host repository's zappy.config.json.
ZAPPY_SITE_ID=default

# Set only in managed deployment settings. Never expose service-role keys to a browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Optional future hosted generation provider. The current app defaults to extractive answers.
HF_TOKEN=
HF_MODEL=
